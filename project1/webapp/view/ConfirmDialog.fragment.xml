<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core">
   <Dialog
      id="ConfirmDialog"
      title ="{i18n>confirmDeletion}">
      <content>
         <Text text="{i18n>confirmQuestion}"/>
      </content>
      <beginButton>
         <Button
            text="{i18n>cancel}"
            press=".onCloseConfirmDialog"/>
      </beginButton>
      <endButton>
         <Button
            text="{i18n>confirm}"
            press=".onDeleteRecord"/>
      </endButton>
   </Dialog>
</core:FragmentDefinition>