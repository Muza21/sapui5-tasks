<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core">
   <Dialog
      id="ConfirmDialog"
      title ="Confirm Deletion">
      <content>
         <Text text="Are you sure you want to delete selected records?"/>
      </content>
      <beginButton>
         <Button
            text="Cancel"
            press=".onCloseConfirmDialog"/>
      </beginButton>
      <endButton>
         <Button
            text="Yes"
            press=".onDeleteRecord"/>
      </endButton>
   </Dialog>
</core:FragmentDefinition>