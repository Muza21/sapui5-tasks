<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core">
   <Dialog
      id="SortDialog"
      title ="Sort books by fields">
      <content>
         <Toolbar>
            <ComboBox id="sortField" placeholder="Field">
               <items>
                     <core:Item key="Name" text="Name"/>
                     <core:Item key="Author" text="Author"/>
                     <core:Item key="Genre" text="Genre"/>
                     <core:Item key="ReleaseDate" text="Release Date"/>
                     <core:Item key="AvailableQuantity" text="Available Quantity"/>
               </items>
            </ComboBox>
            <ComboBox id="sortOrder" placeholder="Order">
               <items>
                     <core:Item key="asc" text="Ascending"/>
                     <core:Item key="desc" text="Descending"/>
               </items>
            </ComboBox>
         </Toolbar>
      </content>
      <beginButton>
         <Button
            text="Cancel"
            press=".onCancelSortDialog"/>
      </beginButton>
      <endButton>
         <Button
            text="Sort"
            press=".onCloseDialogWithSort"/>
      </endButton>
   </Dialog>
</core:FragmentDefinition>