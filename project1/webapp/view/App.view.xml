<mvc:View controllerName="project1.controller.App"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:table="sap.ui.table">
   <App>
      <Page title="Books Management">
         <content>
            <Table id="booksTable" items="{path: 'booksModel>/books'}" mode="SingleSelectLeft">
               <headerToolbar>
                  <Toolbar>
                     <Title text="Books" level="H2"/>
                     <ToolbarSpacer/>
                     <Button
                        text="Sort"
                        icon="sap-icon://sort"
                        type="Default"
                        press=".onOpenSortDialog"/>
                     <Button text="Add Record" icon="sap-icon://add" type="Emphasized" press=".onAddRecord"/>
                     <Button text="Delete Record" icon="sap-icon://delete" type="Reject" press=".onDeleteRecord"/>
                  </Toolbar>
               </headerToolbar>

               <columns>
                  <Column><Label text="Name"/></Column>
                  <Column><Label text="Author"/></Column>
                  <Column><Label text="Genre"/></Column>
                  <Column><Label text="Release Date"/></Column>
                  <Column><Label text="Available Quantity"/></Column>
               </columns>

               <items>
                  <ColumnListItem>
                     <cells>
                        <Text text="{booksModel>Name}"/>
                        <Text text="{booksModel>Author}"/>
                        <Text text="{booksModel>Genre}"/>
                        <Text text="{booksModel>ReleaseDate}"/>
                        <Text text="{booksModel>AvailableQuantity}"/>
                     </cells>
                  </ColumnListItem>
               </items>
            </Table>
         </content>
      </Page>
   </App>
</mvc:View>