<mvc:View
    controllerName="project1.controller.ProductDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:core="sap.ui.core">
    
    <Page title="{i18n>productDetails}">
        <content>
            <smartForm:SmartForm>
               <smartForm:Group title="{i18n>productDetails}">
                    <smartForm:GroupElement label="{i18n>id}">
                        <Text text="{odataV2Model>ID}" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>name}">
                        <Text text="{odataV2Model>Name}" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>description}">
                        <Text text="{odataV2Model>Description}" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>releaseDate}">
                        <Text text="{
                            path: 'odataV2Model>ReleaseDate',
                            type: 'sap.ui.model.odata.type.DateTime',
                            formatOptions: { pattern: 'yyyy-MM-dd' }
                        }" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>rating}">
                        <Text text="{odataV2Model>Rating}" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>price}">
                        <Text text="{odataV2Model>Price}" />
                    </smartForm:GroupElement>
                </smartForm:Group>
                <smartForm:Group title="{i18n>suppliers}">
                    <smartForm:GroupElement>
                        <VBox>
                            <Table
                                id="supplierTable"
                                items="{odataV2Model>Supplier}">
                                <columns>
                                    <Column><Text text="{i18n>supplierId}" /></Column>
                                    <Column><Text text="{i18n>supplierName}" /></Column>
                                    <Column><Text text="{i18n>address}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{odataV2Model>ID}" />
                                            <Text text="{odataV2Model>Name}" />
                                            <Text text="{odataV2Model>Address/Street}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </smartForm:GroupElement>
                </smartForm:Group>
            </smartForm:SmartForm>
        </content>
    </Page>
</mvc:View>
