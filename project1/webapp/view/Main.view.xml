<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>pageTitle}">
        <content>
            <IconTabBar id="idIconTabBar" headerMode="Inline" class="sapUiResponsiveContentPadding">
            <items>
            <IconTabFilter text="{i18n>jsonModel}" key="jsonModel">
            <Toolbar>
               <Input id="titleFilter" placeholder="{i18n>searchBookByTitle}"/>
               <Select id="genreFilter" items="{path: 'booksModel>/genres'}">
                  <core:Item key="{booksModel>}" text="{booksModel>}"/>
               </Select>
               <Button 
                  text="{i18n>filter}" 
                  icon="sap-icon://filter" 
                  type="Emphasized"
                  press=".onFilterBooks"/>
            </Toolbar>
            <Table id="booksTable" items="{path: 'booksModel>/books'}" mode="SingleSelectLeft">
               <headerToolbar>
                  <Toolbar>
                     <Title text="{i18n>books}" level="H2"/>
                     <ToolbarSpacer/>
                     <Button
                        text="{i18n>sort}"
                        icon="sap-icon://sort"
                        type="Default"
                        press=".onOpenSortDialog"/>
                     <Button text="{i18n>addRecord}" icon="sap-icon://add" type="Emphasized" press=".onOpenFormDialog"/>
                     <Button text="{i18n>deleteRecord}" icon="sap-icon://delete" type="Reject" press=".onOpenConfirmDialog"/>
                  </Toolbar>
               </headerToolbar>
               
                
               <columns>
                  <Column><Label text="{i18n>name}"/></Column>
                  <Column><Label text="{i18n>author}"/></Column>
                  <Column><Label text="{i18n>genre}"/></Column>
                  <Column><Label text="{i18n>releaseDate}"/></Column>
                  <Column><Label text="{i18n>availableQuantity}"/></Column>
                  <Column><Label text="{i18n>actions}"/></Column>
               </columns>

               <items>
                  <ColumnListItem>
                     <cells>
                        <Text text="{booksModel>Name}"/>
                        <Text text="{booksModel>Author}"/>
                        <Text text="{booksModel>Genre}"/>
                        <Text
                           core:require="{ Formatter: 'project1/model/formatter' }"
                           text="{  path: 'booksModel>ReleaseDate',
                                    formatter: 'Formatter.dateDisplay.bind($controller)' }"/>
                        <Text text="{booksModel>AvailableQuantity}"/>
                        <Button 
                           text="{i18n>edit}"
                           icon="sap-icon://edit"
                           press=".onEditPress"/>
                     </cells>
                  </ColumnListItem>
               </items>
            </Table>
            </IconTabFilter>
            <IconTabFilter text="{i18n>odataV2Model}" key="odataV2">
               <Table id="productsTableV2" items="{odataV2Model>/Products}" mode="MultiSelect">
                  <headerToolbar>
                        <Toolbar>
                           <Title text="{i18n>productsODataV2}" level="H2"/>
                           <ToolbarSpacer/>
                           <Input id="automaticSearchBar"
                                 placeholder="{i18n>searchBookByTitle}"
                                 width="400px"
                                 liveChange=".onSearchProductsV2"/>
                           <Button 
                              text="{i18n>addRecord}" 
                              icon="sap-icon://add" 
                              type="Emphasized"
                              press=".onOpenFormV2Dialog"/>
                           <Button 
                              text="{i18n>deleteRecord}" 
                              icon="sap-icon://delete" 
                              type="Reject"
                              press=".onDeleteMultiSelectedItems"/>
                        </Toolbar>
                  </headerToolbar>
                  <columns>
                        <Column><Label text="{i18n>id}"/></Column>
                        <Column><Label text="{i18n>name}"/></Column>
                        <Column><Label text="{i18n>description}"/></Column>
                        <Column><Label text="{i18n>releaseDate}"/></Column>
                        <Column><Label text="{i18n>rating}"/></Column>
                        <Column><Label text="{i18n>price}"/></Column>
                        <Column><Label text="{i18n>actions}"/></Column>
                  </columns>
                  <items>
                        <ColumnListItem>
                           <cells>
                              <Text text="{odataV2Model>ID}"/>
                              <Text text="{odataV2Model>Name}"/>
                              <Text text="{odataV2Model>Description}"/>
                              <Text text="{
                                       path: 'odataV2Model>ReleaseDate',
                                       type: 'sap.ui.model.odata.type.DateTime',
                                       formatOptions: {
                                          pattern: 'yyyy-MM-dd',
                                          style: 'medium'
                                       }
                                    }"/>
                              <Text text="{odataV2Model>Rating}"/>
                              <Text text="{odataV2Model>Price}"/>
                              <Button 
                                 text="{i18n>edit}"
                                 icon="sap-icon://edit"
                                 press=".onEditProductsV2"/>
                           </cells>
                        </ColumnListItem>
                  </items>
               </Table>
            </IconTabFilter>

            <IconTabFilter text="{i18n>odataV4Model}" key="odataV4">
               <Table id="productsTableV4" items="{odataV4Model>/Products}">
                  <headerToolbar>
                     <Toolbar>
                           <Title text="{i18n>productsODataV4}" level="H2"/>
                     </Toolbar>
                  </headerToolbar>
                  <columns>
                     <Column><Label text="{i18n>id}"/></Column>
                     <Column><Label text="{i18n>name}"/></Column>
                     <Column><Label text="{i18n>description}"/></Column>
                     <Column><Label text="{i18n>releaseDate}"/></Column>
                     <Column><Label text="{i18n>rating}"/></Column>
                     <Column><Label text="{i18n>price}"/></Column>
                  </columns>
                  <items>
                     <ColumnListItem>
                           <cells>
                              <Text text="{odataV4Model>ID}"/>
                              <Text text="{odataV4Model>Name}"/>
                              <Text text="{odataV4Model>Description}"/>
                              <Text text="{odataV4Model>ReleaseDate}"/>
                              <Text text="{odataV4Model>Rating}"/>
                              <Text text="{odataV4Model>Price}"/>
                           </cells>
                     </ColumnListItem>
                  </items>
               </Table>
            </IconTabFilter>
            </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>