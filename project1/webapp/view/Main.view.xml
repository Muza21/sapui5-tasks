<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="Books Management">
        <content>
            <Toolbar>
               <Input id="titleFilter"/>
               <Select id="genreFilter" items="{path: 'genresModel>/'}">
                  <core:Item key="{genresModel>}" text="{genresModel>}"/>
               </Select>
               <Button 
                  text="Filter" 
                  icon="sap-icon://filter" 
                  type="Emphasized"
                  press=".onFilterBooks"/>
            </Toolbar>
            <Table id="booksTable" items="{path: 'booksModel>/books'}" mode="SingleSelectLeft">
               <headerToolbar>
                  <Toolbar>
                     <Title text="Books" level="H2"/>
                     <ToolbarSpacer/>
                     <Button
                        text="Sort"
                        icon="sap-icon://sort"
                        type="Default"
                        press=".onOpenSortDialog"/>
                     <Button text="Add Record" icon="sap-icon://add" type="Emphasized" press=".onAddRecord"/>
                     <Button text="Delete Record" icon="sap-icon://delete" type="Reject" press=".onDeleteRecord"/>
                  </Toolbar>
               </headerToolbar>
               
                
               <columns>
                  <Column><Label text="Name"/></Column>
                  <Column><Label text="Author"/></Column>
                  <Column><Label text="Genre"/></Column>
                  <Column><Label text="Release Date"/></Column>
                  <Column><Label text="Available Quantity"/></Column>
                  <Column><Label text="Actions"/></Column>
               </columns>

               <items>
                  <ColumnListItem>
                     <cells>
                        <Input id="bookTitleInput" value="{booksModel>Name}" editable="false"/>
                        <Text text="{booksModel>Author}"/>
                        <Text text="{booksModel>Genre}"/>
                        <Text text="{booksModel>ReleaseDate}"/>
                        <Text text="{booksModel>AvailableQuantity}"/>
                        <Button id="editButton" text="Edit Title" icon="sap-icon://edit" press=".onEditPress"/>
                     </cells>
                  </ColumnListItem>
               </items>
            </Table>
        </content>
    </Page>
</mvc:View>